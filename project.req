      "kind": "Functional",
      "links": [],
      "priority": "Could",
      "rationale": "A shared task/result vocabulary (e.g. submitted, working, input-required, completed, failed) makes autonomous orchestration interoperable without each agent inventing its own format.",
      "statement": "The system shall provide an optional JSON content schema for tasks and results carrying a message kind, a lifecycle status, and optional artifacts.",
      "status": "Draft",
      "tags": [],
