    "REQ-0071": {
      "acceptance": [
        "A body of arbitrary bytes is transported and delivered unchanged",
        "The content type is carried alongside the body"
      ],
      "created": "2026-06-28T08:26:10.288175500Z",
      "history": [
        {
          "action": "created",
          "actor": "Tom",
          "actor_kind": "Unknown",
          "at": "2026-06-28T08:26:10.288177400Z",
          "reason": null
        }
      ],
      "id": "REQ-0071",
      "kind": "Constraint",
      "links": [],
      "priority": "Must",
      "rationale": "Keeping the body opaque lets agents exchange free text or any structured payload without the transport imposing a schema.",
      "statement": "The system shall treat the message body as opaque transport content identified solely by its declared content type.",
      "status": "Draft",
      "tags": [],
      "tests": [],
      "title": "Opaque message body with content type",
      "updated": "2026-06-28T08:26:10.288175500Z"
    },
    "REQ-0072": {
      "acceptance": [
        "A plain-text message is presented as text",
