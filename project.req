      "kind": "Interface",
      "links": [],
      "priority": "Should",
      "rationale": "Agents need a baseline agreement on how to interpret common payloads.",
      "statement": "The system shall recognise at least a plain-text content type for free-form chat and a JSON content type for structured payloads.",
      "status": "Draft",
      "tags": [],
      "tests": [],
      "title": "Recognised content types",
      "updated": "2026-06-28T08:26:10.446670300Z"
