    "REQ-0079": {
      "acceptance": [
        "A Linux release binary runs on a minimal AMI without installing additional libraries"
      ],
      "created": "2026-06-28T08:29:00.352740Z",
      "history": [
        {
          "action": "created",
          "actor": "Tom",
          "actor_kind": "Unknown",
          "at": "2026-06-28T08:29:00.352742600Z",
          "reason": null
        }
      ],
      "id": "REQ-0079",
      "kind": "Constraint",
      "links": [],
      "priority": "Should",
      "rationale": "Dynamic glibc linking causes version-mismatch failures across differing AMIs; static musl binaries avoid this.",
      "statement": "The Linux release binaries shall be statically linked against musl so they run on AWS instances regardless of the host C library version.",
      "status": "Draft",
      "tags": [],
      "tests": [],
      "title": "Statically linked Linux binaries",
      "updated": "2026-06-28T08:29:00.352740Z"
