        }
      ],
      "id": "REQ-0112",
      "kind": "Constraint",
      "links": [],
      "priority": "Should",
      "rationale": "The kid is name#fingerprint split on the first '#', so a name containing '#' corrupts signer lookup and audit attribution.",
      "statement": "Identity and authority name creation shall reject names that are empty or contain '#', whitespace, or control characters.",
      "status": "Draft",
      "tags": [
        "v0.2.2",
        "protocol"
      ],
      "tests": [],
      "title": "Agent and authority names must be valid kid components",
