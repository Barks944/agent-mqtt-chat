      "links": [],
      "priority": "Must",
      "rationale": "AWS workers run on Intel/AMD and Graviton instances while the orchestrator runs on Windows.",
      "statement": "The release build shall produce binaries for x86_64 Linux, aarch64 Linux, and x86_64 Windows.",
