          "reason": null
        }
      ],
      "id": "REQ-0073",
      "kind": "Interface",
      "links": [],
      "priority": "Should",
      "rationale": "Orchestrator-to-worker coordination needs results threaded back to the task that requested them.",
      "statement": "The system shall allow a message to carry a correlation identifier naming the message it replies to, and shall expose it to readers.",
      "status": "Draft",
      "tags": [],
      "tests": [],
