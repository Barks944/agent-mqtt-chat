          "reason": null
        }
      ],
      "id": "REQ-0110",
      "kind": "Functional",
      "links": [],
      "priority": "Should",
      "rationale": "An unbounded --wait could hang automation indefinitely when no message ever arrives.",
      "statement": "The read --wait command shall accept a --wait-timeout in seconds after which it returns a timeout error with a distinct exit code; unset or zero preserves the wait-forever behaviour.",
      "status": "Draft",
      "tags": [
        "v0.2.2",
        "cli"
      ],
      "tests": [],
      "title": "read --wait must support a bounded timeout with a distinct exit code",
