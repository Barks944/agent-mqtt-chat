    "REQ-0084": {
      "acceptance": [
        "With allow_unsigned=false an unsigned message is rejected as unsigned_not_allowed",
        "With allow_unsigned=true an unsigned message from an unknown sender is accepted",
        "An unsigned message claiming a known signing agent is rejected as downgrade_rejected"
      ],
      "created": "2026-06-29T14:57:48.420310800Z",
      "history": [
        {
          "action": "created via batch",
