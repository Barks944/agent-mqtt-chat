        }
      ],
      "id": "REQ-0109",
      "kind": "Constraint",
      "links": [],
      "priority": "Must",
      "rationale": "The broker credentials (config.toml) and plaintext message history (messages.db) were left umask-default readable, unlike the 0600 identity/authority key files.",
      "statement": "On Unix the daemon shall restrict config.toml and messages.db (and its WAL/SHM sidecars) to owner read/write (0600) and the data directory to owner access (0700).",
      "status": "Draft",
      "tags": [
        "v0.2.2",
        "hardening"
      ],
      "tests": [],
