          "reason": null
        }
      ],
      "id": "REQ-0084",
      "kind": "Functional",
      "links": [],
      "priority": "Must",
      "rationale": "Low-security environments want signing-free channels, but an unsigned message must never be accepted for a sender that is otherwise authenticated, to prevent downgrade spoofing.",
      "statement": "The daemon shall accept an unsigned (alg=none) inbound message only when allow_unsigned is enabled, and shall reject an unsigned message whose claimed sender is already known with a signing key.",
      "status": "Draft",
      "tags": [
        "v0.2",
        "issue-7",
        "security"
      ],
      "tests": [],
      "title": "Unsigned channel mode with downgrade protection",
